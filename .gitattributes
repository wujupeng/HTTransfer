# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must always use LF
*.sh text eol=lf
postinst text eol=lf
postrm text eol=lf
prerm text eol=lf
preinst text eol=lf

# Desktop files
*.desktop text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.ico binary
*.exe binary